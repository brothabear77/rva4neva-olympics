#!/bin/sh
# Keep the local database in step with what a push to main will do to production.
#
# Mirrors .github/workflows/deploy.yml: production migrates when a push touches drizzle/,
# and (pre-kickoff only) reseeds when it touches scripts/seed.ts. Here we do the same to
# the local Docker database. Never blocks the push: if the DB isn't reachable (Colima or
# `npm run db:up` not running) it prints a warning and lets the push through.

zero=0000000000000000000000000000000000000000
migrate=false
seed=false

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
  else
    base=$remote_sha
  fi
  if [ -z "$base" ]; then
    migrate=true; seed=true; continue
  fi
  git diff --quiet "$base" "$local_sha" -- drizzle/ || migrate=true
  git diff --quiet "$base" "$local_sha" -- scripts/seed.ts || seed=true
done

if [ "$migrate" = false ] && [ "$seed" = false ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 0

if [ "$migrate" = true ]; then
  echo "pre-push: drizzle/ changed, applying migrations locally..."
  npm run --silent db:migrate || echo "pre-push: WARNING local migration failed (is the DB up? colima start && npm run db:up). Push continues."
fi

if [ "$seed" = true ]; then
  started=$(npx --no-install tsx -e "import { hasStarted } from './src/lib/site'; process.stdout.write(String(hasStarted()));" 2>/dev/null)
  if [ "$started" = "true" ]; then
    echo "pre-push: scripts/seed.ts changed, but the games have started; production won't reseed, so neither do we."
  else
    echo "pre-push: scripts/seed.ts changed, reseeding locally..."
    npm run --silent db:seed || echo "pre-push: WARNING local seed failed. Push continues."
  fi
fi

exit 0
