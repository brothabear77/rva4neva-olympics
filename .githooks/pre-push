#!/bin/sh
# Keep the local database in step with what a push to main will do to production.
#
# Mirrors .github/workflows/deploy.yml: production migrates when a push touches drizzle/,
# and (pre-kickoff only) re-syncs its events when it touches src/lib/eventCatalog.ts.
# Here we do the same to the local Docker database. (Production is never seeded, so
# changes to scripts/seed.ts don't trigger anything; run `npm run db:seed` yourself.) Never blocks the push: if the DB isn't reachable (Colima or
# `npm run db:up` not running) it prints a warning and lets the push through.

zero=0000000000000000000000000000000000000000
migrate=false
events=false

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
  else
    base=$remote_sha
  fi
  if [ -z "$base" ]; then
    migrate=true; events=true; continue
  fi
  git diff --quiet "$base" "$local_sha" -- drizzle/ || migrate=true
  git diff --quiet "$base" "$local_sha" -- src/lib/eventCatalog.ts || events=true
done

if [ "$migrate" = false ] && [ "$events" = false ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 0

if [ "$migrate" = true ]; then
  echo "pre-push: drizzle/ changed, applying migrations locally..."
  npm run --silent db:migrate || echo "pre-push: WARNING local migration failed (is the DB up? colima start && npm run db:up). Push continues."
fi

if [ "$events" = true ]; then
  started=$(npx --no-install tsx -e "import { hasStarted } from './src/lib/site'; process.stdout.write(String(hasStarted()));" 2>/dev/null)
  if [ "$started" = "true" ]; then
    echo "pre-push: the event catalog changed, but the games have started; production won't re-sync, so neither do we."
  else
    echo "pre-push: the event catalog changed, re-syncing events locally..."
    npx --no-install tsx scripts/sync-events.ts || echo "pre-push: WARNING local events sync failed. Push continues."
  fi
fi

exit 0
