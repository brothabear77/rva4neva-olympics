		<string>Fonts/Oswald-Bold.ttf</string>
		<string>Fonts/Geist-Regular.ttf</string>
		<string>Fonts/Geist-Medium.ttf</string>
		<string>Fonts/Geist-SemiBold.ttf</string>
		<string>Fonts/Geist-Bold.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Ink</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
