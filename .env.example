# Local development (npm run db:up starts Postgres and the MinIO storage below)
DATABASE_URL="postgresql://olympics:olympics@localhost:5433/olympics"
DATABASE_SSL="false"

# Vlog videos, locally: S3Mock from docker-compose.yml stands in for S3 (any keys work). The bucket is
# created by `npm run db:up`. Leave VLOG_MEDIA_BUCKET empty to keep uploads switched off.
VLOG_MEDIA_BUCKET="rva4neva-vlog-dev"
VLOG_MEDIA_ENDPOINT="http://localhost:9090"
VLOG_MEDIA_ACCESS_KEY_ID="local"
VLOG_MEDIA_SECRET_ACCESS_KEY="local-secret"

# Production (AWS): none of this is set by hand. `npm run aws:db` writes DATABASE_URL to
# Secrets Manager and App Runner injects it, with sslmode=verify-full. The image trusts
# Amazon's RDS certificate authority through NODE_EXTRA_CA_CERTS. See infra/aws.md.
#
# Optional, and already given sensible values in production:
# DATABASE_POOL_MAX="4"                 connections per app instance
# DATABASE_CONNECT_TIMEOUT_MS="30000"   how long to wait for a paused Aurora to wake
#
# Never set DATABASE_SSL in production. It exists only to turn TLS off for local Docker.

# LaunchDarkly server-side SDK key (Project settings > Environments > SDK key).
# Without it, feature flags fall back to their defaults.
LAUNCHDARKLY_SDK_KEY=""

# Spotify app credentials (developer.spotify.com/dashboard > the app > Settings), used to
# search for athletes' walkout songs. Without them the search box is hidden; songs already
# chosen still play.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Vlog videos in production: none of the VLOG_MEDIA_* values are set by hand. The CDK stack
# creates the S3 bucket, sets VLOG_MEDIA_BUCKET on the App Runner service, and lets the
# instance role read and write it. Never set VLOG_MEDIA_ENDPOINT or the access keys there:
# they exist only to point the app at the local S3Mock. See infra/aws.md, "Vlog media".
